FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Avoid interactive debconf prompts during apt installs
ENV DEBIAN_FRONTEND=noninteractive

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install minimal set
COPY requirements.txt .

# Install only essential Python dependencies (no Playwright for now)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn[standard]==0.27.0 \
    pydantic==2.6.0 \
    httpx==0.26.0 \
    python-dotenv==1.0.0 \
    requests==2.31.0

# Copy application code
COPY main.py .
COPY quiz_solver.py .
COPY scraper.py .
COPY prompts.py .
COPY app.py .

# Expose port for HF Spaces
EXPOSE 7860

# Set environment variables for HF Spaces
ENV PORT=7860
ENV PYTHONUNBUFFERED=1

# Run uvicorn directly
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860", "--log-level", "info"]
